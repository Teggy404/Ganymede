@using Ganymede.Theme;
@inherits LayoutComponentBase

<MudThemeProvider Theme="GanymedeTheme.Default" IsDarkMode="true"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <NavBar/>
    <MudDrawer @bind-Open="_leftOpen"
        Anchor="Anchor.Left"
        Variant="DrawerVariant.Persistent"
        Elevation="0"
        ClipMode="DrawerClipMode.Always"
        Width="200px">
    </MudDrawer>

    <MudDrawer @bind-Open="_rightOpen"
        Anchor="Anchor.Right"
        Variant="DrawerVariant.Persistent"
        Elevation="0"
        ClipMode="DrawerClipMode.Always"
        Width="300px"
    >
   
    </MudDrawer>

    <MudMainContent>
        <div class="editor-row">
            <div class="editor-leftarrow">
                <MudIconButton Icon="@(_leftOpen ? Icons.Material.Filled.ArrowLeft : Icons.Material.Filled.ArrowRight)" Color="Color.Inherit" OnClick="leftAlternate" />
            </div>
            <div class="editor-canvas">@Body</div>
            <div class="editor-rightarrow">
                <MudIconButton Icon="@(_rightOpen ? Icons.Material.Filled.ArrowRight : Icons.Material.Filled.ArrowLeft)" Color="Color.Inherit" OnClick="rightAlternate" />
            </div>
        </div>
    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _leftOpen = false;
    private void leftAlternate() => _leftOpen = !_leftOpen;

    private bool _rightOpen = false;
    private void rightAlternate() => _rightOpen = !_rightOpen;
}

